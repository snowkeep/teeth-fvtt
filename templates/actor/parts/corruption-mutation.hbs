<div class="corruption-mutation">
  <div class="corruption item-header sheet-heading">
    <h3 class="corruption-title">{{localize "TEETH.Corruption"}}</h3>
    <a
      class="item-control add-mutation"
      data-tooltip="{{localize 'TEETH.Mutation.Roll'}}"
    ><i class="fa-solid fa-plus"></i></a>
  </div>
  <div
    class="value-step-block angled-track"
    data-value="{{system.corruption.value}}"
    data-key="system.corruption.value"
  >
    {{#numLoop system.corruption.max}}
      <span class="value-step" data-index="{{this}}"></span>
    {{/numLoop}}
  </div>
  <div class="mutation-list">
    <ol>
      {{#each system.mutations}}
        <li class="mutation" data-index="{{@index}}">
          <div class="item-description">
            {{this.text}}
          </div>
          <div class="item-controls">
            <a class="mutation-control mutation-show" data-value="{{@index}}" title="{{localize 'TEETH.Item.Show'}}" ><i class="fas fa-comment"></i></a>
            <a class="mutation-control edit-mutation" data-value="{{@index}}" title="{{localize 'TEETH.Item.Edit'}}" ><i class="fas fa-edit"></i></a>
            <a class="mutation-control delete-mutation" data-value="{{@index}}" title="{{localize 'TEETH.Item.Delete'}}" ><i class="fas fa-trash"></i></a>
          </div>
        </li>
      {{/each}}
    </ol>
  </div>
</div>
